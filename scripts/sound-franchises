#!/usr/bin/env python3
"""Refreshes the franchise list the Sounds screen filters by (ADR-200).

The OpenPeon registry does not say which franchise a pack belongs to; openpeon.com keeps that list
in its own source (`site/src/lib/constants.ts`, MIT), with a TODO to move it into the registry. This
reads that file and writes the names, links and keys Clinic bundles. A pack's franchise is the one
whose keys hold its name, else the first of its tags that one holds, which is how the site resolves it.

    scripts/sound-franchises [ref]      # ref defaults to main
"""
import json
import re
import sys
import urllib.request
from pathlib import Path

REF = sys.argv[1] if len(sys.argv) > 1 else "main"
SOURCE = f"https://raw.githubusercontent.com/PeonPing/openpeon/{REF}/site/src/lib/constants.ts"
OUT = Path(__file__).resolve().parent.parent / "Packages/ClinicCore/Sources/ClinicCore/Resources/sound-franchises.json"

text = urllib.request.urlopen(SOURCE, timeout=30).read().decode()
body = text[text.index("const FRANCHISES"):text.index("export const FRANCHISE_MAP")]
franchises = []
for m in re.finditer(r'\n  ("([^"]+)"|([A-Za-z0-9_]+)):\s*\{(.*?)\n  \}', body, re.S):
    name, inner = m.group(2) or m.group(3), m.group(4)
    url = re.search(r'url:\s*"([^"]*)"', inner)
    keys = []
    for field in ("packs", "tags"):
        found = re.search(field + r":\s*\[(.*?)\]", inner, re.S)
        if found:
            keys += [k.lower() for k in re.findall(r'"([^"]+)"', found.group(1))]
    if keys:
        franchises.append({"name": name, "url": url.group(1) if url else "", "keys": keys})

if len(franchises) < 20:
    sys.exit(f"error: only {len(franchises)} franchises parsed from {SOURCE}; the file's shape has changed")
OUT.write_text(json.dumps({
    "source": SOURCE,
    "license": "MIT, Copyright (c) 2026 PeonPing (https://github.com/PeonPing/openpeon/blob/main/LICENSE)",
    "franchises": sorted(franchises, key=lambda f: f["name"].lower()),
}, ensure_ascii=False, indent=1) + "\n")
print(f"{len(franchises)} franchises written to {OUT.relative_to(Path.cwd()) if OUT.is_relative_to(Path.cwd()) else OUT}")
