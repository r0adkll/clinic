#!/usr/bin/env python3
"""
Guided, interactive release of Clinic from main (ADR-153).

The version being released is MARKETING_VERSION in Version.xcconfig. The script walks
through these steps, stopping at each blocker with a concrete way to resolve it:

  1. Preflight   on main, clean tree, up to date with origin, gh authenticated, Developer ID
                 certificate and the clinic-notary profile present, version is semver and not
                 yet tagged or released
  2. Build       scripts/release.sh — archive, Developer ID export, notarize, staple, zip.
                 Output is quiet; it is captured to build/publish/*.log. A zip already built
                 for this version can be reused.
  3. Smoke test  launches the notarized app and waits for it to quit — or for Enter, to go on
                 with it still running. A running Clinic is detected and the smoke instance
                 gets its own data directory so it does not take over the live app's sockets.
  4. Notes       release notes from the commits since the previous tag, editable in $EDITOR
  5. Publish     push main, tag <version> (no "v"), GitHub Release with the zip attached,
                 Casks/clinic.rb rewritten and pushed in r0adkll/homebrew-tap

Usage:
  scripts/publish                  # the guided flow
  scripts/publish --reuse-build    # preselect reusing build/release/Clinic-<version>.zip
  scripts/publish --skip-smoke     # don't launch the app
  scripts/publish --notes FILE     # release notes from a file instead of the commit list
  scripts/publish --yes            # non-interactive: take the defaults, never prompt (no smoke test)
  scripts/publish --dry-run        # show what would happen; nothing is built, tagged or pushed

A prerelease version (0.2.0-beta.1) is published as a GitHub pre-release and the cask is left
alone: `releases/latest` — which the in-app update check reads — ignores pre-releases, and so
does the tap.
"""

import argparse
import hashlib
import itertools
import os
import re
import select
import shutil
import subprocess
import sys
import tempfile
import threading
import time
from datetime import datetime
from pathlib import Path

REPO_ROOT = Path(__file__).resolve().parent.parent
VERSION_XCCONFIG = REPO_ROOT / "Version.xcconfig"
RELEASE_SCRIPT = REPO_ROOT / "scripts/release.sh"
RELEASE_DIR = REPO_ROOT / "build/release"          # scripts/release.sh recreates this
LOG_DIR = REPO_ROOT / "build/publish"              # so logs and notes live here instead
TAP_DIR = LOG_DIR / "homebrew-tap"
SMOKE_DATA_DIR = LOG_DIR / "smoke-data"

REPO = "r0adkll/clinic"
REPO_URL = f"https://github.com/{REPO}"
TAP_REPO = "r0adkll/homebrew-tap"
NOTARY_PROFILE = "clinic-notary"
SEMVER_REGEX = re.compile(r"^(0|[1-9]\d*)\.(0|[1-9]\d*)\.(0|[1-9]\d*)(-[0-9A-Za-z.-]+)?$")
APP_PROCESS_PATTERN = "Clinic.app/Contents/MacOS/Clinic"

CASK_TEMPLATE = '''# Written by scripts/publish in r0adkll/clinic for each release; edit it there.
cask "clinic" do
  version "{version}"
  sha256 "{sha256}"

  url "https://github.com/{repo}/releases/download/#{{version}}/Clinic-#{{version}}.zip"
  name "Clinic"
  desc "Claude Code session manager on libghostty"
  homepage "https://github.com/{repo}"

  livecheck do
    url :url
    strategy :github_latest
  end

  depends_on arch: :arm64
  depends_on macos: :sequoia

  app "Clinic.app"

  uninstall launchctl: "com.r0adkll.clinic.wake",
            quit:      "com.r0adkll.clinic"

  zap trash: [
    "~/Library/Application Support/Clinic",
    "~/Library/Preferences/com.r0adkll.clinic.plist",
  ]

  caveats "Clinic runs the claude CLI, which must be on your PATH."
end
'''


# =========================================================================== terminal ui

IS_TTY = sys.stdout.isatty()


def style(text, *codes):
    if not IS_TTY or not codes:
        return text
    return "\033[" + ";".join(str(c) for c in codes) + "m" + text + "\033[0m"


BOLD, DIM, RED, GREEN, YELLOW, BLUE, CYAN = 1, 2, 31, 32, 33, 34, 36


def header(number, title):
    print()
    print(style(f"━━ {number}. {title} ", BOLD, CYAN) + style("━" * max(0, 60 - len(title)), CYAN))


def ok(message):
    print(style("  ✔ ", GREEN) + message)


def info(message):
    print("  · " + message)


def warn(message):
    print(style("  ! ", YELLOW) + message)


def error(message):
    print(style("  ✘ ", RED) + message)


def block(text, indent="    "):
    for line in text.rstrip("\n").splitlines():
        print(style(indent + line, DIM))


class Abort(Exception):
    """Stop the release; the message has already been explained to the user."""


class Ui:
    """Prompts. In --yes mode every question takes its default without asking."""

    def __init__(self, assume_yes):
        self.assume_yes = assume_yes

    def confirm(self, question, default=False):
        if self.assume_yes:
            return default
        suffix = " [Y/n] " if default else " [y/N] "
        while True:
            answer = input(style("  ? ", BLUE) + question + suffix).strip().lower()
            if not answer:
                return default
            if answer in ("y", "yes"):
                return True
            if answer in ("n", "no"):
                return False

    def choose(self, question, options, default_key):
        """options: list of (key, label). Returns the chosen key."""
        if self.assume_yes:
            return default_key
        print(style("  ? ", BLUE) + question)
        for key, label in options:
            marker = style(" (default)", DIM) if key == default_key else ""
            print(f"      {style(key, BOLD)}  {label}{marker}")
        keys = {key for key, _ in options}
        while True:
            answer = input("    › ").strip().lower()
            if not answer:
                return default_key
            if answer in keys:
                return answer


class Spinner:
    """A one-line progress indicator while a long subprocess runs quietly."""

    def __init__(self, message):
        self.message = message
        self._stop = threading.Event()
        self._thread = threading.Thread(target=self._spin, daemon=True)
        self._started = time.monotonic()

    def __enter__(self):
        if IS_TTY:
            self._thread.start()
        else:
            print("  … " + self.message)
        return self

    def __exit__(self, *_):
        self._stop.set()
        if IS_TTY:
            self._thread.join()
            sys.stdout.write("\r\033[K")
            sys.stdout.flush()

    def elapsed(self):
        return time.monotonic() - self._started

    def _spin(self):
        for frame in itertools.cycle("⠋⠙⠹⠸⠼⠴⠦⠧⠇⠏"):
            if self._stop.is_set():
                break
            minutes, seconds = divmod(int(self.elapsed()), 60)
            sys.stdout.write(f"\r  {style(frame, CYAN)} {self.message} {style(f'{minutes:02d}:{seconds:02d}', DIM)}")
            sys.stdout.flush()
            time.sleep(0.1)


def mmss(seconds):
    minutes, seconds = divmod(int(seconds), 60)
    return f"{minutes} min {seconds}s" if minutes else f"{seconds}s"


# =========================================================================== helpers


def run(args, check=True, capture=True, cwd=None):
    return subprocess.run(args, cwd=cwd or REPO_ROOT, check=check, capture_output=capture, text=True)


def git(*args, check=True, cwd=None):
    return run(["git", *args], check=check, cwd=cwd).stdout.strip()


def run_quietly(args, message, log_name):
    """Runs a long command with output captured to build/publish/<log_name>-<timestamp>.log.
    Returns (returncode, log_path, elapsed_seconds)."""
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOG_DIR / f"{log_name}-{datetime.now():%Y%m%d-%H%M%S}.log"
    with log_path.open("w") as log, Spinner(message) as spinner:
        log.write("$ " + " ".join(str(a) for a in args) + "\n\n")
        log.flush()
        result = subprocess.run([str(a) for a in args], cwd=REPO_ROOT, stdout=log, stderr=subprocess.STDOUT)
        elapsed = spinner.elapsed()
    return result.returncode, log_path, elapsed


def show_log_tail(log_path, lines=25):
    content = log_path.read_text().splitlines()
    interesting = [line for line in content if re.search(r"error|failed|invalid|rejected", line, re.IGNORECASE)]
    block("\n".join((interesting or content)[-lines:]))
    info(f"full log: {log_path.relative_to(REPO_ROOT)}")


def editor_name():
    return os.environ.get("VISUAL") or os.environ.get("EDITOR") or shutil.which("nano") or "vi"


def open_in_editor(path):
    subprocess.run([*editor_name().split(), str(path)], cwd=REPO_ROOT)


def sha256_of(path):
    digest = hashlib.sha256()
    with path.open("rb") as f:
        for chunk in iter(lambda: f.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def plist_value(plist, key):
    return run(["plutil", "-extract", key, "raw", "-o", "-", str(plist)]).stdout.strip()


# =========================================================================== versions


def read_version():
    match = re.search(r"^MARKETING_VERSION\s*=\s*(.+?)\s*$", VERSION_XCCONFIG.read_text(), re.MULTILINE)
    if not match:
        raise Abort("could not find MARKETING_VERSION in Version.xcconfig")
    version = match.group(1)
    if not SEMVER_REGEX.match(version):
        raise Abort(f"MARKETING_VERSION '{version}' is not semver (MAJOR.MINOR.PATCH[-prerelease])")
    return version


def is_prerelease(version):
    return SEMVER_REGEX.match(version).group(4) is not None


def tag_exists(tag):
    return run(["git", "rev-parse", "-q", "--verify", f"refs/tags/{tag}"], check=False).returncode == 0


def previous_tag():
    return run(["git", "describe", "--tags", "--abbrev=0"], check=False).stdout.strip() or None


def zip_path(version):
    return RELEASE_DIR / f"Clinic-{version}.zip"


def app_path():
    return RELEASE_DIR / "export/Clinic.app"


# =========================================================================== steps


def step_preflight(ui, version, dry_run):
    header(1, f"Preflight — releasing {style(version, BOLD)}")

    branch = git("rev-parse", "--abbrev-ref", "HEAD")
    if branch != "main":
        error(f"on branch '{branch}'; releases are cut from main")
        raise Abort("switch to main and re-run")
    ok("on main")

    if run(["gh", "auth", "status"], check=False).returncode != 0:
        error("gh is not authenticated")
        raise Abort("run `gh auth login` and re-run")
    ok("gh authenticated")

    if not (REPO_ROOT / "Local.xcconfig").exists():
        error("Local.xcconfig is missing (it carries DEVELOPMENT_TEAM for signing)")
        raise Abort("cp Local.xcconfig.example Local.xcconfig, fill in the team id, and re-run")
    identities = run(["security", "find-identity", "-v", "-p", "codesigning"], check=False).stdout
    if "Developer ID Application" not in identities:
        error("no 'Developer ID Application' certificate in the keychain")
        raise Abort("Xcode > Settings > Accounts > Manage Certificates > + > Developer ID Application")
    ok("Developer ID Application certificate present")

    with Spinner(f"checking notary credentials ({NOTARY_PROFILE})"):
        notary = run(["xcrun", "notarytool", "history", "--keychain-profile", NOTARY_PROFILE], check=False)
    if notary.returncode != 0:
        error(f"notarytool cannot use the keychain profile '{NOTARY_PROFILE}'")
        block(notary.stderr or notary.stdout)
        raise Abort(f"xcrun notarytool store-credentials {NOTARY_PROFILE} --apple-id <id> --team-id <team> --password <app-specific-password>")
    ok("notary credentials work")

    if tag_exists(version):
        error(f"tag {version} already exists")
        raise Abort("bump MARKETING_VERSION in Version.xcconfig to the version you want to release")
    if run(["gh", "release", "view", version, "--repo", REPO], check=False).returncode == 0:
        error(f"GitHub release {version} already exists")
        raise Abort("bump MARKETING_VERSION in Version.xcconfig to the version you want to release")
    ok(f"{version} is not tagged or released yet" + (" (prerelease)" if is_prerelease(version) else ""))

    with Spinner("fetching origin"):
        run(["git", "fetch", "--quiet", "origin", "main", "--tags"])
    behind = int(git("rev-list", "--count", "HEAD..origin/main"))
    ahead = int(git("rev-list", "--count", "origin/main..HEAD"))
    if behind:
        warn(f"main is {behind} commit(s) behind origin/main")
        if dry_run or not ui.confirm("Fast-forward main to origin/main now?", default=True):
            raise Abort("pull main and re-run")
        run(["git", "pull", "--ff-only", "--quiet", "origin", "main"])
        ok("fast-forwarded to origin/main")
    else:
        ok("up to date with origin/main" + (f" ({ahead} unpushed commit(s) will go out with the release)" if ahead else ""))

    status = run(["git", "status", "--porcelain"]).stdout
    if status.strip():
        warn("working tree is not clean:")
        block("\n".join(line[3:] for line in status.splitlines()))
        raise Abort("commit or stash the changes so the tag points at what was built")
    ok("working tree clean")
    return ahead


def zip_is_this_version(zip_file, version):
    """True if the zip holds a stapled Clinic.app reporting `version`."""
    with tempfile.TemporaryDirectory() as tmp:
        run(["ditto", "-x", "-k", str(zip_file), tmp])
        app = Path(tmp) / "Clinic.app"
        if not app.exists():
            return False, "no Clinic.app inside"
        zipped = plist_value(app / "Contents/Info.plist", "CFBundleShortVersionString")
        if zipped != version:
            return False, f"it contains Clinic {zipped}"
        if run(["xcrun", "stapler", "validate", str(app)], check=False).returncode != 0:
            return False, "it is not stapled"
    return True, ""


def step_build(ui, version, args, dry_run):
    header(2, "Build, notarize and staple")
    zip_file = zip_path(version)

    reuse = False
    if zip_file.exists():
        age = mmss(time.time() - zip_file.stat().st_mtime)
        info(f"{zip_file.relative_to(REPO_ROOT)} exists, built {age} ago")
        choice = "u" if args.reuse_build else ui.choose(
            "Rebuild it, or reuse it?",
            [("r", "rebuild (archive, notarize, staple — several minutes)"), ("u", "reuse the existing zip")],
            default_key="r",
        )
        if choice == "u":
            with Spinner("checking the existing zip"):
                good, why = zip_is_this_version(zip_file, version)
            if good and app_path().exists():
                reuse = True
                ok("reusing it")
            else:
                warn(f"cannot reuse it: {why or 'the exported app beside it is gone'}; rebuilding")

    if not reuse:
        if dry_run:
            info(f"[dry-run] would run {RELEASE_SCRIPT.relative_to(REPO_ROOT)} (build number {git('rev-list', '--count', 'HEAD')})")
            return None
        while True:
            code, log_path, elapsed = run_quietly(
                [RELEASE_SCRIPT], f"building, notarizing and stapling Clinic {version}", "release")
            if code == 0:
                ok(f"built in {mmss(elapsed)}")
                info(f"log: {log_path.relative_to(REPO_ROOT)}")
                break
            error(f"release build failed after {mmss(elapsed)}")
            show_log_tail(log_path)
            if ui.choose("What next?", [("r", "retry"), ("a", "abort")], default_key="a") == "a":
                raise Abort("fix the build and re-run")

    app = app_path()
    assessment = run(["spctl", "-a", "-vv", str(app)], check=False)
    if "accepted" not in assessment.stderr + assessment.stdout:
        error("Gatekeeper does not accept the app")
        block(assessment.stderr or assessment.stdout)
        raise Abort("the build is not notarized correctly; see the log")
    ok("Gatekeeper accepts it (source: " + (re.search(r"source=([^\n]+)", assessment.stderr + assessment.stdout) or [None, "?"])[1] + ")")
    sha = sha256_of(zip_file)
    info(f"{zip_file.name}: {zip_file.stat().st_size / 1048576:.1f} MB, sha256 {sha}")
    return sha


def running_clinics():
    """Paths of running Clinic apps. `ps` rather than `pgrep -f`: pgrep cannot read other
    processes' arguments from a sandboxed shell, while comm is always visible."""
    result = run(["ps", "-axo", "comm="], check=False)
    return [line.strip() for line in result.stdout.splitlines() if line.strip().endswith(APP_PROCESS_PATTERN)]


def wait_for_app_or_enter(proc):
    """Returns 'quit' when the app exits, 'enter' when the user presses Enter first."""
    if not IS_TTY:
        proc.wait()
        return "quit"
    while True:
        if proc.poll() is not None:
            return "quit"
        readable, _, _ = select.select([sys.stdin], [], [], 0.25)
        if readable:
            sys.stdin.readline()
            return "enter"


def step_smoke(ui, args, dry_run):
    header(3, "Smoke test")
    if dry_run:
        info("[dry-run] would launch the notarized app for a smoke test")
        return
    if args.skip_smoke or ui.assume_yes:
        info("skipped")
        return

    app = app_path()
    running = running_clinics()
    if running:
        warn("Clinic is already running: " + ", ".join(running))
        info("a second instance on the default data directory would take over the live app's sockets")
        choice = ui.choose(
            "Launch the release build how?",
            [("i", f"with its own data directory ({SMOKE_DATA_DIR.relative_to(REPO_ROOT)}); preferences are still shared"),
             ("d", "on the default data directory anyway (quit the running Clinic first)"),
             ("s", "skip the smoke test")],
            default_key="i",
        )
    else:
        choice = ui.choose(
            "Launch the release build how?",
            [("d", "on the default data directory, like an install"),
             ("i", f"with its own data directory ({SMOKE_DATA_DIR.relative_to(REPO_ROOT)})"),
             ("s", "skip the smoke test")],
            default_key="d",
        )
    if choice == "s":
        info("skipped")
        return

    command = ["open", "-n", "-W"]
    if choice == "i":
        SMOKE_DATA_DIR.mkdir(parents=True, exist_ok=True)
        command += ["--env", f"CLINIC_APP_SUPPORT={SMOKE_DATA_DIR}"]
    command.append(str(app))
    started = time.monotonic()
    proc = subprocess.Popen(command, cwd=REPO_ROOT)
    print(style("  ▶ ", CYAN) + f"launched {app.relative_to(REPO_ROOT)}")
    info("quit the app when you are done, or press Enter to continue with it still running")
    outcome = wait_for_app_or_enter(proc)
    if outcome == "quit":
        ok(f"app quit after {mmss(time.monotonic() - started)}")
    else:
        info("continuing with the app still running")
    if not ui.confirm("Did the smoke test pass?", default=True):
        raise Abort("fix what you found, commit, and re-run (the build will be redone for the new commit)")


def build_notes(version, prev_tag):
    lines = []   # no title line: GitHub shows the release name above the body, and the name is the version
    if prev_tag:
        subjects = git("log", "--first-parent", "--reverse", "--format=%s", f"{prev_tag}..HEAD").splitlines()
        lines += ["## What's Changed", "", *(f"- {s}" for s in subjects), "",
                  f"**Full Changelog**: {REPO_URL}/compare/{prev_tag}...{version}", ""]
    else:
        lines += ["The first public build.", ""]
    lines += [
        "## Install", "",
        "Apple Silicon, macOS 15 or later. Clinic runs the `claude` CLI, which must be on your `PATH`.", "",
        "```sh", "brew install --cask r0adkll/tap/clinic", "```", "",
        f"Or download `Clinic-{version}.zip` below. Developer ID-signed and notarized.", "",
    ]
    return "\n".join(lines)


def step_notes(ui, version, args, dry_run):
    header(4, "Release notes")
    LOG_DIR.mkdir(parents=True, exist_ok=True)
    notes_path = LOG_DIR / f"notes-{version}.md"
    if args.notes:
        notes_path = Path(args.notes).resolve()
        if not notes_path.exists():
            raise Abort(f"{args.notes} does not exist")
        ok(f"notes from {args.notes}")
    elif notes_path.exists():
        ok(f"{notes_path.relative_to(REPO_ROOT)} already exists (keeping your edits)")
    else:
        prev_tag = previous_tag()
        notes_path.write_text(build_notes(version, prev_tag))
        info(f"previous release: {prev_tag or 'none — this is the first'}")
        ok(f"wrote {notes_path.relative_to(REPO_ROOT)}")
    block(notes_path.read_text())
    if not dry_run and ui.confirm(f"Edit the notes in {editor_name()}?", default=False):
        open_in_editor(notes_path)
        block(notes_path.read_text())
    return notes_path


def write_cask(version, sha):
    return CASK_TEMPLATE.format(version=version, sha256=sha, repo=REPO)


def update_tap(version, sha):
    if TAP_DIR.joinpath(".git").exists():
        branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=TAP_DIR)
        run(["git", "fetch", "--quiet", "origin"], cwd=TAP_DIR)
        run(["git", "reset", "--quiet", "--hard", f"origin/{branch}"], cwd=TAP_DIR)
    else:
        run(["gh", "repo", "clone", TAP_REPO, str(TAP_DIR), "--", "--quiet"])
    cask = TAP_DIR / "Casks/clinic.rb"
    cask.parent.mkdir(exist_ok=True)
    text = write_cask(version, sha)
    if cask.exists() and cask.read_text() == text:
        return False
    cask.write_text(text)
    run(["git", "add", "Casks/clinic.rb"], cwd=TAP_DIR)
    run(["git", "commit", "--quiet", "-m", f"clinic {version}"], cwd=TAP_DIR)
    run(["git", "push", "--quiet", "origin", "HEAD"], cwd=TAP_DIR)
    return True


def step_publish(ui, version, sha, notes_path, ahead, dry_run):
    header(5, "Publish")
    prerelease = is_prerelease(version)
    zip_file = zip_path(version)

    if dry_run:
        if ahead:
            info(f"[dry-run] would push {ahead} commit(s) to origin/main")
        info(f"[dry-run] would tag {version}, push it, and create GitHub release '{version}'"
             + (" as a pre-release" if prerelease else "") + f" with {zip_file.name}")
        info("[dry-run] would leave the cask alone (pre-release)" if prerelease
             else f"[dry-run] would write Casks/clinic.rb in {TAP_REPO} and push it as 'clinic {version}'")
        return

    what = f"Tag {style(version, BOLD)}, create the GitHub Release" + ("" if prerelease else " and update the cask")
    if not ui.confirm(what + "?", default=True):
        raise Abort("nothing was pushed; re-run when ready (the build and notes are kept)")

    if ahead:
        with Spinner("pushing main"):
            run(["git", "push", "--quiet", "origin", "main"])
        ok("pushed main")
    run(["git", "tag", "-a", version, "-m", f"Clinic {version}"])
    with Spinner(f"pushing tag {version}"):
        run(["git", "push", "--quiet", "origin", version])
    ok(f"tagged {version}")

    with Spinner(f"creating GitHub release {version} and uploading {zip_file.name}"):
        run([
            "gh", "release", "create", version, str(zip_file),
            "--repo", REPO, "--title", version, "--notes-file", str(notes_path), "--verify-tag",
            *(["--prerelease"] if prerelease else []),
        ])
    ok(f"release created: {REPO_URL}/releases/tag/{version}")

    if prerelease:
        info("pre-release: the cask stays at the last stable version")
        return
    with Spinner(f"updating Casks/clinic.rb in {TAP_REPO}"):
        changed = update_tap(version, sha)
    ok(f"cask {'pushed' if changed else 'already current'}: {TAP_REPO} → clinic {version}")
    info("install:  brew install --cask r0adkll/tap/clinic")

    if ui.confirm("Verify the cask with brew (update + fetch, checks the URL and sha256)?", default=False):
        code, log_path, elapsed = run_quietly(
            ["bash", "-c", "brew update --quiet && brew fetch --cask r0adkll/tap/clinic"], "brew update && brew fetch", "brew")
        if code == 0:
            ok(f"brew fetched the cask in {mmss(elapsed)}")
        else:
            error("brew could not fetch the cask")
            show_log_tail(log_path)


# =========================================================================== main


def main():
    parser = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    parser.add_argument("--reuse-build", action="store_true", help="reuse build/release/Clinic-<version>.zip if it exists")
    parser.add_argument("--skip-smoke", action="store_true", help="don't launch the app for a smoke test")
    parser.add_argument("--notes", metavar="FILE", help="release notes file (default: generated from commits)")
    parser.add_argument("--dry-run", action="store_true", help="show what would happen without building or pushing")
    parser.add_argument("-y", "--yes", action="store_true", help="non-interactive: accept defaults, never prompt")
    args = parser.parse_args()

    ui = Ui(assume_yes=args.yes)
    try:
        if args.dry_run:
            print(style("dry run — nothing will be built, tagged, pushed or created", YELLOW))
        version = read_version()
        ahead = step_preflight(ui, version, args.dry_run)
        sha = step_build(ui, version, args, args.dry_run)
        step_smoke(ui, args, args.dry_run)
        notes_path = step_notes(ui, version, args, args.dry_run)
        step_publish(ui, version, sha, notes_path, ahead, args.dry_run)
        print()
        print(style(f"🎉 Clinic {version} is out.", BOLD, GREEN))
    except Abort as e:
        print()
        print(style("aborted: ", RED, BOLD) + str(e))
        sys.exit(1)
    except KeyboardInterrupt:
        print()
        print(style("interrupted — nothing further was changed", YELLOW))
        sys.exit(130)
    except subprocess.CalledProcessError as e:
        print()
        print(style("command failed: ", RED, BOLD) + " ".join(str(a) for a in e.cmd))
        if e.stderr:
            block(e.stderr)
        sys.exit(e.returncode)


if __name__ == "__main__":
    main()
